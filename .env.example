# LiteLLM API configuration
LITELLM_API_KEY=sk-...
LITELLM_BASE_URL=http://100.89.168.11:6280/v1
LITELLM_MODEL=chat

# Audio device for tscribe (find yours with `tscribe devices`)
TSCRIBE_DEVICE_ID=17

# Transcription model (uses LITELLM_BASE_URL and LITELLM_API_KEY)
# TRANSCRIPTION_MODEL=Systran/faster-distil-whisper-large-v3

# Rate limiting for LLM requests
# MAX_RETRIES=3
# BACKOFF_FACTOR=1.0

# macOS say voice settings (optional -- omit to use system default)
# SAY_VOICE=Daniel
# SAY_RATE=200

# Qwen3-TTS Server (for voice-chat-streaming)
# TTS_SERVER_URL=http://100.125.210.60:8001/v1/audio/speech
# TTS_MODEL=qwen3-tts-voice-clone
# TTS_VOICE=danial
# TTS_INSTRUCTIONS=
